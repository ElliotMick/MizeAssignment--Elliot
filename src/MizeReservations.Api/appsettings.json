{
  "ConnectionStrings": {
    "Reservations": "Server=(localdb)\\MSSQLLocalDB;Database=MizeReservations;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=30"
  },
  "Throttling": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Ingest": {
    "MaxWriteAttempts": 5
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
