{
  "info": {
    "name": "Mize Reservations",
    "description": "Requests for the reservation ingestion service. Start the API first (`dotnet run --project src/MizeReservations.Api --launch-profile http`).\n\n* **1. Idempotency**: run the requests in order (or run the folder). Request 1.1 generates a fresh reservationId, so the sequence can be repeated.\n* **2. Stats**: ingested vs. throttled counters for `{{supplierId}}`.\n* **3. Throttling**: run this folder in the Collection Runner with **105 iterations**. The first 100 return 201 and the rest return 429 with a Retry-After header. Wait for the window to clear (up to 60 s) before running it again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "supplierId", "value": "acme" },
    { "key": "reservationId", "value": "R-1001" }
  ],
  "item": [
    {
      "name": "1. Idempotency",
      "item": [
        {
          "name": "1.1 New reservation → 201 Created",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// A fresh reservation id per run, so 1.1 → 1.4 behave the same every time.",
                "pm.collectionVariables.set('reservationId', 'R-' + Date.now());"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "pm.test('outcome is Created', () => pm.expect(pm.response.json().outcome).to.eql('Created'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/reservations/ingest",
            "body": { "mode": "raw", "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"reservationId\": \"{{reservationId}}\",\n  \"roomId\": \"room-101\",\n  \"checkIn\": \"2026-08-01T00:00:00Z\",\n  \"checkOut\": \"2026-08-03T00:00:00Z\",\n  \"price\": 450.00,\n  \"updatedAtUtc\": \"2026-07-01T10:15:00Z\"\n}" }
          }
        },
        {
          "name": "1.2 Exact resend → 200 Unchanged (nothing written)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "pm.test('outcome is Unchanged', () => pm.expect(pm.response.json().outcome).to.eql('Unchanged'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/reservations/ingest",
            "body": { "mode": "raw", "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"reservationId\": \"{{reservationId}}\",\n  \"roomId\": \"room-101\",\n  \"checkIn\": \"2026-08-01T00:00:00Z\",\n  \"checkOut\": \"2026-08-03T00:00:00Z\",\n  \"price\": 450.00,\n  \"updatedAtUtc\": \"2026-07-01T10:15:00Z\"\n}" }
          }
        },
        {
          "name": "1.3 Changed price, newer updatedAtUtc → 200 Updated",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "pm.test('outcome is Updated', () => pm.expect(pm.response.json().outcome).to.eql('Updated'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/reservations/ingest",
            "body": { "mode": "raw", "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"reservationId\": \"{{reservationId}}\",\n  \"roomId\": \"room-101\",\n  \"checkIn\": \"2026-08-01T00:00:00Z\",\n  \"checkOut\": \"2026-08-03T00:00:00Z\",\n  \"price\": 500.00,\n  \"updatedAtUtc\": \"2026-07-02T08:00:00Z\"\n}" }
          }
        },
        {
          "name": "1.4 Older version (delayed retry of 1.1) → 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                "pm.test('outcome is Stale', () => pm.expect(pm.response.json().outcome).to.eql('Stale'));",
                "pm.test('reports the stored version', () => pm.expect(pm.response.json().storedUpdatedAtUtc).to.eql('2026-07-02T08:00:00Z'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/reservations/ingest",
            "body": { "mode": "raw", "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"reservationId\": \"{{reservationId}}\",\n  \"roomId\": \"room-101\",\n  \"checkIn\": \"2026-08-01T00:00:00Z\",\n  \"checkOut\": \"2026-08-03T00:00:00Z\",\n  \"price\": 450.00,\n  \"updatedAtUtc\": \"2026-07-01T10:15:00Z\"\n}" }
          }
        },
        {
          "name": "1.5 Invalid payload → 400 Bad Request",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                "pm.test('names the invalid fields', () => pm.expect(pm.response.json().errors).to.have.all.keys('checkOut', 'price'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/reservations/ingest",
            "body": { "mode": "raw", "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"reservationId\": \"R-invalid\",\n  \"roomId\": \"room-101\",\n  \"checkIn\": \"2026-08-03T00:00:00Z\",\n  \"checkOut\": \"2026-08-01T00:00:00Z\",\n  \"price\": 450.123,\n  \"updatedAtUtc\": \"2026-07-01T10:15:00Z\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Stats",
      "event": [
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('has ingested and throttled counts', () => pm.expect(pm.response.json()).to.include.keys('ingested', 'throttled', 'breakdown'));"
          ] }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/reservations/stats/{{supplierId}}"
      }
    },
    {
      "name": "3. Throttling",
      "item": [
        {
          "name": "Flood (run with 105 iterations) → 201 ×100, then 429",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 under the limit, 429 over it', () => pm.expect(pm.response.code).to.be.oneOf([201, 429]));",
                "if (pm.response.code === 429) {",
                "    pm.test('429 carries Retry-After', () => pm.response.to.have.header('Retry-After'));",
                "}"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/reservations/ingest",
            "body": { "mode": "raw", "raw": "{\n  \"supplierId\": \"flood-supplier\",\n  \"reservationId\": \"{{$guid}}\",\n  \"roomId\": \"room-101\",\n  \"checkIn\": \"2026-08-01T00:00:00Z\",\n  \"checkOut\": \"2026-08-03T00:00:00Z\",\n  \"price\": 450.00,\n  \"updatedAtUtc\": \"2026-07-01T10:15:00Z\"\n}" }
          }
        },
        {
          "name": "Stats of flood-supplier",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reservations/stats/flood-supplier"
          }
        }
      ]
    }
  ]
}
